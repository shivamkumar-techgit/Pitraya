generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  draft
  lead
  coordinator_assigned
  payment_pending
  awaiting_payment
  paid
  confirmed
  hotel_reserved
  vehicle_assigned
  pandit_assigned
  in_journey
  completed
  cancelled
}

enum PaymentStatus {
  not_requested
  link_generated
  pending
  partially_paid
  paid
  refunded
  failed
}

enum JourneyStatus {
  not_started
  arrival
  hotel_checkin
  rituals
  departure
  completed
}

enum TravelMode {
  flight
  train
  road
}

enum PaymentMethod {
  UPI
  Bank_Transfer
  Card
  WhatsApp_Pay
}

enum DocType {
  reservation_letter
  invoice
  payment_receipt
  journey_itinerary
  temple_schedule
}

enum ReviewStatus {
  pending_request
  review_sent
  completed
}

enum NotificationType {
  confirmation
  vehicle
  hotel
  payment_link
  review_request
}

enum PreferredLanguage {
  EN
  HI
  TA
  TE
  KN
  BN
  MR
  GU
}

// 1. CUSTOMER (User Profile)
model Customer {
  id                String            @id @default(uuid())
  name              String
  phone             String            @unique
  email             String
  city              String
  country           String            @default("India")
  preferredLanguage PreferredLanguage @default(EN)
  createdAt         DateTime          @default(now())

  bookings Booking[]
  reviews  Review[]
}

// 2. PACKAGE (Pilgrimage Tier)
model Package {
  id            String    @id @default(uuid())
  title         String
  startingPrice Float
  duration      String
  description   String?
  createdAt     DateTime  @default(now())

  bookings Booking[]
}

// 3. BOOKING (Master Pilgrimage Record - Center of Everything)
model Booking {
  id                  String            @id @default(uuid())
  reservationId       String            @unique
  customerId          String
  packageId           String
  packageTitle        String
  duration            String
  status              BookingStatus     @default(lead)
  journeyStatus       JourneyStatus     @default(not_started)
  grandTotal          Float
  adults              Int               @default(2)
  elders              Int               @default(0)
  children            Int               @default(0)
  totalCount          Int               @default(2)
  wheelchairNeeded    Boolean           @default(false)
  airportPickupNeeded Boolean           @default(false)
  preferredLanguage   PreferredLanguage @default(EN)
  hotelId             String?
  vehicleId           String?
  panditId            String?
  coordinatorId       String?
  isDeleted           Boolean           @default(false)
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package     Package      @relation(fields: [packageId], references: [id])
  hotel       Hotel?       @relation(fields: [hotelId], references: [id])
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  pandit      Pandit?      @relation(fields: [panditId], references: [id])
  coordinator Coordinator? @relation(fields: [coordinatorId], references: [id])

  travel        Travel?
  addons        Addon[]
  payments      Payment[]
  activities    Activity[]
  timelines     BookingTimeline[]
  tasks         BookingTask[]
  notes         BookingNote[]
  documents     Document[]
  reviews       Review[]
  notifications Notification[]
}

// 4. TRAVEL (Arrival Logistics)
model Travel {
  id                  String     @id @default(uuid())
  bookingId           String     @unique
  mode                TravelMode @default(flight)
  arrivalDate         String
  arrivalTime         String
  flightOrTrainNumber String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// 5. HOTEL (Sattvik Accommodation)
model Hotel {
  id             String   @id @default(uuid())
  name           String
  starRating     Int      @default(4)
  address        String
  googleMapsUrl  String
  checkInTime    String   @default("12:00 PM")
  pricePerNight  Float    @default(3500)
  totalRooms     Int      @default(20)
  availableRooms Int      @default(15)

  bookings Booking[]
}

// 6. VEHICLE (Private Chauffeur & Transfers)
model Vehicle {
  id            String   @id @default(uuid())
  name          String
  driverName    String
  driverPhone   String
  vehicleNumber String

  bookings Booking[]
}

// 7. ADDONS (Samagri, Extra Oblation & Pandits)
model Addon {
  id        String   @id @default(uuid())
  bookingId String
  title     String
  price     Float
  category  String   @default("Oblation Kit")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Pandit {
  id               String   @id @default(uuid())
  name             String
  phone            String
  title            String
  sanctumSpecialty String

  bookings Booking[]
}

// 8. PAYMENTS (Transactions & Deposits)
model Payment {
  id                String        @id @default(uuid())
  bookingId         String
  amount            Float
  paymentMethod     PaymentMethod @default(UPI)
  transactionRef    String        @unique
  razorpayPaymentId String?       @unique
  status            PaymentStatus @default(not_requested)
  paymentLink       String
  issuedAt          DateTime      @default(now())
  paidAt            DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  COORDINATOR
  ACCOUNTANT
  OPERATOR
}

model User {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  password            String
  role                AdminRole    @default(OPERATOR)
  coordinatorId       String?      @unique
  resetTokenHash      String?
  resetTokenExpiry    DateTime?
  failedLoginAttempts Int          @default(0)
  lockUntil           DateTime?
  coordinator         Coordinator? @relation(fields: [coordinatorId], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String?
  action    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ErrorLog {
  id         String   @id @default(uuid())
  requestId  String?
  errorClass String
  message    String
  stack      String?
  route      String?
  method     String?
  statusCode Int      @default(500)
  userId     String?
  userRole   String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

// 9. COORDINATOR (Concierge Escort Manager)
model Coordinator {
  id    String @id @default(uuid())
  name  String
  phone String
  role  String

  bookings Booking[]
  user     User?
}

// 10. ACTIVITY & TIMELINE (Sacred Rites Audit Timeline)
model Activity {
  id            String   @id @default(uuid())
  bookingId     String
  dayNumber     Int
  title         String
  description   String
  location      String
  scheduledTime String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingTimeline {
  id          String   @id @default(uuid())
  bookingId   String
  title       String
  description String
  timestamp   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// Dynamic Operational Tasks Engine
model BookingTask {
  id          String    @id @default(uuid())
  bookingId   String
  taskKey     String
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// Coordinator Internal Notes
model BookingNote {
  id        String   @id @default(uuid())
  bookingId String
  author    String   @default("Coordinator")
  content   String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// 11. DOCUMENTS (5 Auto-Generated PDF Vouchers)
model Document {
  id           String    @id @default(uuid())
  bookingId    String?
  docType      DocType   @default(invoice)
  title        String
  fileName     String    @default("document.pdf")
  originalName String    @default("document.pdf")
  mimeType     String    @default("application/pdf")
  fileSize     Int       @default(0)
  cloudinaryId String?
  secureUrl    String    @default("")
  downloadUrl  String    @default("")
  folder       String    @default("pitraya/bookings")
  uploadedBy   String    @default("System")
  generatedAt  DateTime  @default(now())
  deletedAt    DateTime?

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([cloudinaryId])
}

// 12. REVIEWS (Post-Journey Automation & Referrals)
model Review {
  id              String       @id @default(uuid())
  bookingId       String
  customerId      String
  googleReviewUrl String
  photoUrls       String[]
  feedbackRating  Int?
  feedbackText    String?
  referralCode    String
  status          ReviewStatus @default(pending_request)
  createdAt       DateTime     @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String           @id @default(uuid())
  bookingId      String
  type           NotificationType
  recipientPhone String
  channel        String           @default("whatsapp")
  content        String
  sentAt         DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
